{
  "name": "qa-upskilling-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit.test.ts tests/ai.test.ts tests/qa-coverage.test.ts tests/gemini-provider.test.ts",
    "test:known-defects": "vitest run tests/known-defects",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:invite": "node --import tsx scripts/invite.ts",
    "catalogue:validate": "node --import tsx scripts/validate-catalogue.ts",
    "postinstall": "prisma generate",
    "ai:configure-mock": "node --import tsx scripts/configure-mock.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.5",
    "lucide-react": "1.50.0",
    "next": "16.3.8",
    "next-auth": "4.24.15",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unicode-case-folding": "1.1.2",
    "zod": "4.6.5",
    "pdf-parse": "2.4.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "type": "module"
}
