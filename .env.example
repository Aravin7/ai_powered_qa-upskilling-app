# Local development only. Never commit a populated .env.
DATABASE_URL=postgresql://qa:qa_local_only@localhost:5432/qa_pathway
DIRECT_DATABASE_URL=postgresql://qa:qa_local_only@localhost:5432/qa_pathway
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only for local Google testing with synthetic inputs; rejected in production.
ENABLE_SYNTHETIC_PILOT=false
# Connected workflow: local synthetic data only. Production rejects mock mode.
# AI_MODE=groq is the local synthetic Free Plan demo; see docs/GROQ-DEMO.md.
AI_MODE=disabled
# Set AI_MODE=mock and generate a separate random signing secret (at least 32 characters).
AI_SIGNING_SECRET=
AI_BUDGET_ID=local-mock-v1
# Run npm run ai:configure-mock once after migrating. Units are mock counters, not money.
# To switch, set AI_MODE=groq and AI_BUDGET_ID=local-groq-demo-v1.
# Keep the key in this ignored local .env only, never in source or client-side variables.
GROQ_API_KEY=
# Set true only after checking that the Groq account is on the Free Plan.
# The API cannot verify billing tier; do not upgrade while using this demo.
GROQ_FREE_PLAN_CONFIRMED=false
# Run npm run db:deploy and npm run ai:configure-groq; model is openai/gpt-oss-20b.
