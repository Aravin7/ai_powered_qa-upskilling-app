generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model Invitation {
  email String @id
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model User {
  id String @id @default(uuid())
  googleSubject String @unique
  email String @unique
  name String
  status String @default("active")
  sessionVersion Int @default(0)
  createdAt DateTime @default(now())
  profile Profile?
  skills ConfirmedSkill[]
  consents Consent[]
  roadmaps Roadmap[]
  operations AIOperation[]
  pathwayExploration PathwayExploration?
  reviewedDirection ReviewedDirection?
}
model PathwayExploration {
  userId String @id
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  preferences Json
  suggestions Json @default("[]")
  inputRevision Int
  libraryVersion String
  selectedSuggestionId String?
  operationId String?
  resourcePreviews Json @default("[]")
}
model Profile {
  userId String @id
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  currentRole String @default("")
  yearsExperience Int @default(0)
  hoursPerWeek Int @default(5)
  confirmed Boolean @default(false)
  inventoryConfirmed Boolean @default(false)
  planningRevision Int @default(0)
}
model ConfirmedSkill {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  key String
  canonicalSkillId String?
  label String
  source String @default("manual")
  catalogueVersion String
  confirmedAt DateTime @default(now())
  capabilityConfirmation CapabilityConfirmation?
  @@unique([userId, key])
}
// Registered snapshots are immutable; registration alone does not activate content.
model RequirementSnapshot {
  version String @id
  contentDigest String
  content Json
  reviewEvidenceReference String
  registeredAt DateTime @default(now())
  confirmations CapabilityConfirmation[]
  activations RequirementActivation[]
  selections ReviewedDirection[]
}
model ReviewedDirection {
  userId String @id
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  snapshotVersion String
  snapshot RequirementSnapshot @relation(fields:[snapshotVersion], references:[version], onDelete:Restrict)
  directionId String
  label String
  deferredCapabilityIds String[] @default([])
  requirementSetId String
  resourcePreviews Json @default("[]")
}
model RequirementActivation {
  id String @id
  version String
  snapshot RequirementSnapshot @relation(fields:[version], references:[version], onDelete:Restrict)
  revision Int @default(1)
  activatedAt DateTime @default(now())
}
model CapabilityConfirmation {
  skillId String @id
  skill ConfirmedSkill @relation(fields:[skillId], references:[id], onDelete:Cascade)
  snapshotVersion String
  snapshot RequirementSnapshot @relation(fields:[snapshotVersion], references:[version], onDelete:Restrict)
  capabilityId String
  meaningVersion String
  confirmedAt DateTime @default(now())
}
model Consent {
  id String @id @default(uuid())
  sequence Int @unique @default(autoincrement())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  purpose String
  granted Boolean
  policyVersion String
  recordedAt DateTime @default(now())
  @@index([userId, purpose, recordedAt])
}
model Roadmap {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  status String @default("active")
  inputRevision Int
  catalogueVersion String
  createdAt DateTime @default(now())
  deferredSkillIds String[] @default([])
  planningSnapshot Json?
  modelVersion String @default("legacy-synthetic")
  promptVersion String @default("legacy-synthetic")
  tasks RoadmapTask[]
  @@index([userId, status])
}

model CatalogueRevision {
  id String @id
  version String
  revision Int @default(1)
}
model AIOperation {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  kind String
  key String
  fingerprint String
  state String @default("running")
  code String @default("RUNNING")
  fence String @default(uuid())
  sessionVersion Int
  consentSequence Int
  inputRevision Int
  catalogueRevision Int
  catalogueVersion String
  deadline DateTime
  createdAt DateTime @default(now())
  attempts Int @default(0)
  roadmapId String?
  dispatches AIAttempt[]
  configurationVersion String @default("mock-v1")
  budgetId String?
  @@unique([userId, kind, key])
}
model AIAttempt {
  id String @id @default(uuid())
  operationId String
  operation AIOperation @relation(fields:[operationId], references:[id], onDelete:Cascade)
  reservedAt DateTime @default(now())
  budgetId String
  budget FundingBudget @relation(fields:[budgetId], references:[id])
  reservedUnits Int
  @@index([reservedAt])
}
model FundingBudget {
  id String @id
  mode String
  currency String
  pricingVersion String
  ceiling Int
  reserved Int @default(0)
  expiresAt DateTime
  enabled Boolean @default(true)
  configuration Json?
  attempts AIAttempt[]
}
model RoadmapTask {
  id String @id @default(uuid())
  roadmapId String
  roadmap Roadmap @relation(fields:[roadmapId], references:[id], onDelete:Cascade)
  position Int
  week Int
  title String
  activity String
  completionCriterion String
  kind String
  skillIds String[]
  resourceIds String[]
  estimatedMinutes Int
  completed Boolean @default(false)
  revision Int @default(0)
  @@unique([roadmapId, position])
}
